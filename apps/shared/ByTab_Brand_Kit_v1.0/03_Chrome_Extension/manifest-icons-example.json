{
  "manifest_version": 3,
  "name": "bytab",
  "version": "1.0.0",
  "description": "Personal new tab with organized bookmarks and shortcuts.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
