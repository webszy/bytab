{
  "name": "@bytab/extension",
  "description": "A clean new tab for your bookmarks.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "compile": "vue-tsc --noEmit",
    "typecheck": "pnpm compile",
    "test": "node --test tests/bookmark-tree.test.mjs",
    "test:browser": "node tests/bookmarks.browser.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vue-tsc": "^3.2.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.5"
  }
}
